# ─── Base de datos ──────────────────────────────────────────
# Puerto 5433: el 5432 del host ya esta ocupado por otro proyecto.
POSTGRES_PASSWORD="proofpath"
DATABASE_URL="postgresql://proofpath:proofpath@localhost:5433/proofpath?schema=public"

# ─── Cadena (01-CONTRACTS-SPEC §5) ──────────────────────────
ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"
TALENTPASS_ADDRESS=""
ATTESTATION_REGISTRY_ADDRESS=""

# Solo se requiere para publicar/verificar el código fuente en el explorer.
# No es necesario para conectarse al RPC ni para desplegar transacciones.
ETHERSCAN_API_KEY=""

# Wallet unica del backend: es el minter del SBT y el issuer del registry.
# Necesita ETH de faucet en Arbitrum Sepolia. NUNCA commitear el .env real.
RELAYER_PRIVATE_KEY=""

# ARBITRUM | MOCK — MockChainAdapter es el plan B de la demo (00-CONTEXT §7)
CHAIN_ADAPTER="MOCK"

# ─── Wallets embebidas del talento ──────────────────────────
# El keypair del voluntario se genera en el backend y se guarda cifrado.
# Clave AES-256-GCM en hex de 32 bytes: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=""

# ─── IA (00-CONTEXT §6) ─────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OPENAI | MOCK — sin API key se degrada solo a MOCK y avisa por log.
# El MOCK extrae del texto de las contribuciones, no devuelve datos fijos.
SKILL_EXTRACTOR="OPENAI"

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=""

# Firma independiente para los códigos de verificación y recuperación.
# Generar con: openssl rand -hex 32
AUTH_CODE_SECRET=""

# En desarrollo, si RESEND_API_KEY está vacío, el código aparece en la
# respuesta y en los logs. En producción estas dos variables son obligatorias.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="ProofPath <acceso@tu-dominio.com>"

# Solo para la carga inicial; usar valores privados en el servidor.
SEED_ORG_EMAIL=""
SEED_ORG_PASSWORD=""
SEED_TALENT_PASSWORD=""

# ─── API pública ────────────────────────────────────────────
# En producción es obligatorio. Separa varios orígenes con coma.
CORS_ORIGINS="http://localhost:3000"
HOST="0.0.0.0"
PORT="3001"

# ─── IPFS (opcional en el MVP, los CID son nullable) ────────
PINATA_JWT=""

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_CHAIN_ID="421614"
NEXT_PUBLIC_ARBISCAN_URL="https://sepolia.arbiscan.io"
